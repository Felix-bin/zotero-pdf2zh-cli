{
  "manifest_version": 2,
  "name": "PDF2zh CLI",
  "version": "0.1.0",
  "description": "右键直接调用本机 pdf2zh 命令翻译 PDF，无需常驻服务。",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "applications": {
    "zotero": {
      "id": "pdf2zh-cli@local",
      "update_url": "https://localhost/pdf2zh-cli/update.json",
      "strict_min_version": "10.0",
      "strict_max_version": "11.*"
    }
  }
}
